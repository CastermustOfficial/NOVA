{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA",
  "version": "0.1.0",
  "identifier": "io.nova.assistente",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "orb",
        "title": "NOVA",
        "url": "orb.html",
        "width": 96,
        "height": 96,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "center": false,
        "x": 1600,
        "y": 800,
        "focus": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
